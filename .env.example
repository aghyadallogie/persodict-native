# Copy to .env and fill in. EXPO_PUBLIC_* values are inlined into the JS bundle (not secret).

# Backend base URL, with no trailing slash and no /api (the routes are at the root; /api is only
# the Swagger UI). On a physical device don't use localhost.
EXPO_PUBLIC_API_URL=https://persodict-be.vercel.app

# Google Cloud Console > Credentials > OAuth client ID of type "Web application".
# The same ID is the `audience` the backend verifies Google ID tokens against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
